{
  "name": "@vendora/core",
  "version": "0.1.0",
  "description": "Provider-independent domain core for reliable digital commerce",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "pnpm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
