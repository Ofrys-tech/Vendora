{
  "name": "@vendora/core",
  "version": "0.2.0",
  "description": "Provider-independent domain core for reliable digital commerce",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
